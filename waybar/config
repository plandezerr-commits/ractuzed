{
  "layer": "top",
  "position": "top",
  "height": 32,
  "modules-left": ["sway/workspaces"],
  "modules-center": ["sway/window"],
  "modules-right": [
    "network",
    "pulseaudio",
    "battery",
    "clock",
    "tray"
  ],
  "sway/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "default": ""
    }
  },
  "network": {
    "format-wifi": "<span color=\"#88c0d0\"></span> {essid}",
    "format-ethernet": "<span color=\"#88c0d0\"></span> {ifname}",
    "format-disconnected": "<span color=\"#bf616a\"></span> Sin red",
    "tooltip-format": "{ifname} - {essid}\n{signalStrength}% señal"
  },
  "pulseaudio": {
    "format": "{volume}% <span color=\"#88c0d0\">{icon}</span>",
    "format-muted": "<span color=\"#bf616a\"></span> Silenciado",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    }
  },
  "battery": {
    "format": "{capacity}% <span color=\"#a3be8c\">{icon}</span>",
    "format-charging": "{capacity}% <span color=\"#ebcb8b\"></span>",
    "format-icons": ["", "", "", "", ""],
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "clock": {
    "format": "<span color=\"#88c0d0\"></span> {:%H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
